# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact + community (leave blank until real values exist; the UI hides what is empty)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=

# Social profiles (leave blank to hide)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Lead capture: POST endpoint that accepts { name, email, source, consent } JSON.
# Point this at your email provider / form backend. When blank, forms run in clearly labelled demo mode.
NEXT_PUBLIC_LEADS_ENDPOINT=
